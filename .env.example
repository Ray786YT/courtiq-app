# CourtIQ environment variables
#
# Local development: copy to .env and fill in.
# Production: set these in the Vercel dashboard under Settings > Environment Variables.

# Neon Postgres. Use the POOLED connection string (the host contains "-pooler"),
# not the direct one. Serverless functions open many short-lived connections and
# the pooled endpoint is what handles that.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/courtiq?sslmode=require

# The passcode you and the coach type to sign in. The build hashes it with
# scrypt and stores only the hash. Change it here and redeploy to rotate it.
COURTIQ_PASSCODE=

# Signs the session cookie. Any random string of 32+ characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this signs everyone out. It is not the team passcode.
SESSION_SECRET=

# Voice note parsing. Without it the app still works, and /api/voice returns 503.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5.
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Must match the team row created by the seed script.
# DEFAULT_TEAM_SLUG=slss-senior-boys
